# Copy this file to .env and fill in real values. Never commit .env.
#
# Everything in this extension runs and infers locally by default (no
# network calls are required for core stress detection). These variables
# only matter if you wire up optional cloud sync / export features.

# Feature flags
VITE_ENABLE_CLOUD_SYNC=false
VITE_ENABLE_PDF_EXPORT=true

# Only needed if VITE_ENABLE_CLOUD_SYNC=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
