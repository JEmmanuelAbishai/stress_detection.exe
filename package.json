{
  "name": "stress-detection-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Typing-behavior stress detection Chrome extension (React + TypeScript + TailwindCSS + Python/ONNX ML).",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "jspdf": "^2.5.2",
    "onnxruntime-web": "^1.19.2",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/chrome": "^0.0.269",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^2.0.5"
  }
}
